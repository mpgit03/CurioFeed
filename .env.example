# Copy this file to .env and fill in real credentials.
# Never commit your real .env file.

# Required for the local PostgreSQL container
POSTGRES_PASSWORD=curiofeed_local_dev

# Backend secrets / integrations
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
GEMINI_API_KEY=
CURSOR_SECRET=
LOG_LEVEL=info
ENABLE_SCHEDULERS=true

# Frontend values are embedded at Next.js build time
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
FRONTEND_URL=http://localhost:3000
